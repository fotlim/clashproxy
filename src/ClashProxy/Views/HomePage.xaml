<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashProxy.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer>
        <StackPanel Padding="28,18,28,28" Spacing="18">

            <StackPanel Spacing="4">
                <TextBlock Text="总览" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="给指定应用或指定网站单独开一条代理通道，系统全局保持直连。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
            </StackPanel>

            <!-- 状态卡 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="22">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="Dot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                            <TextBlock x:Name="StateLabel" Text="通道未启动" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="StateDetail" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="点击右侧按钮启动内核，启动后即可让应用走代理。" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="StartBtn" Content="启动" Style="{StaticResource AccentButtonStyle}"
                                Click="StartBtn_Click" MinWidth="88" />
                        <Button x:Name="StopBtn" Content="停止" Click="StopBtn_Click" MinWidth="88" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 端口卡 -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="规则通道" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RulePortText" Text="127.0.0.1:7890" FontSize="18" FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="只代理「分流规则」里勾选的网站，其余直连"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="应用通道" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AppPortText" Text="127.0.0.1:7891" FontSize="18" FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="进这个口就全部走代理，专供指定应用使用"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 当前节点 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="当前节点" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NodeText" Text="尚未选择" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="测试连通性" Click="TestBtn_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="ResultText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
