<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashProxy.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashProxy">

    <Grid Padding="28,18,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="分流规则" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="列表里的网站走代理，其余全部直连。规则作用于 7890 端口（规则通道）。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 新增表单 -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="KindBox" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="1">
                        <ComboBoxItem Content="精确域名" Tag="DOMAIN" />
                        <ComboBoxItem Content="域名后缀" Tag="DOMAIN-SUFFIX" />
                        <ComboBoxItem Content="关键字" Tag="DOMAIN-KEYWORD" />
                    </ComboBox>

                    <TextBox x:Name="ValueBox" Grid.Column="1"
                             PlaceholderText="例如 google.com 或 github.com"
                             KeyDown="ValueBox_KeyDown" />

                    <Button Grid.Column="2" Content="添加" Style="{StaticResource AccentButtonStyle}"
                            Click="AddBtn_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="导入常用列表" Click="PresetBtn_Click" />
                    <Button Content="清空全部" Click="ClearBtn_Click" />
                    <Button Content="保存并应用" Click="ApplyBtn_Click" />
                    <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 规则列表 -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="4,4,4,4">
            <ListView x:Name="RuleList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SiteRule">
                        <Grid ColumnSpacing="10" Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                      Checked="Rule_Toggled" Unchecked="Rule_Toggled" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Value}" FontSize="14" />
                                <TextBlock Text="{x:Bind KindLabel}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="删除" FontSize="12" Click="DeleteBtn_Click"
                                    Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
