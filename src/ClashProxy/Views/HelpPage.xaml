<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashProxy.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,18,28,32" Spacing="18">

            <StackPanel Spacing="4">
                <TextBlock Text="使用说明" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="三条路：网站走代理、应用走代理、全局走代理。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="22">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="6">
                        <TextBlock Text="一、准备" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="① 到「订阅与节点」粘贴你的 Clash 订阅链接，点「下载并解析」。&#x0a;② 在节点列表里挑一个，点「使用选中节点」。&#x0a;③ 点「应用到内核」生成配置，再回「总览」点「启动」。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="二、让指定网站走代理" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="到「分流规则」添加域名（如 google.com），点「保存并应用」。&#x0a;之后凡是能把代理指向 127.0.0.1:7890 的程序，访问这些域名时会走代理，访问其它域名仍然直连。&#x0a;规则类型：域名后缀最常用（google.com 同时覆盖 www.google.com）；精确域名只匹配那一个；关键字按子串匹配。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="三、让指定应用走代理（推荐）" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="到「应用通道」点「添加程序…」选一个 exe，然后点它右边的「走代理启动」。&#x0a;ClashProxy 只会给这个进程注入 HTTPS_PROXY=http://127.0.0.1:7891，该端口不做规则判断，进来全部走代理。&#x0a;系统其它程序完全不受影响，也不需要改 Windows 的代理设置。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="四、手动给任意命令行挂代理" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22" FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="在 cmd 里先执行：&#x0a;set HTTPS_PROXY=http://127.0.0.1:7891&#x0a;set HTTP_PROXY=http://127.0.0.1:7891&#x0a;然后再运行你的命令。这两行只影响当前窗口。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="五、两个端口的区别" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="7890 = 规则通道。按「分流规则」判断，列表内走代理，其余直连。适合浏览器这类需要混合上网的程序。&#x0a;7891 = 应用通道。不做判断，全部走代理。适合只要外网的工具（下载器、命令行、特定客户端）。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="六、常见问题" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="· 启动后打不开网页：先看「运行日志」，多半是节点不通，换个节点试试。&#x0a;· 改了规则或换了订阅：点「保存并应用」/「应用到内核」会自动重启内核，等它自己转一圈就好。&#x0a;· 程序必须重启才认代理：环境变量只在新进程启动时读取，已经在跑的程序要先关掉。&#x0a;· 不想用了：点「停止」，或者直接关掉 ClashProxy，系统网络立即恢复直连，不会留下任何系统代理设置。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="七、数据在哪" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="DataPathText" FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- 关于 / 开发者信息 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于本项目" FontSize="15" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="开发者" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="fotlim" FontSize="13" />
                            <TextBlock Text="·" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="GithubLink" Content="github.com/fotlim" FontSize="13"
                                             Padding="0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="项目地址" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Grid.Row="1" Grid.Column="1" x:Name="RepoLink"
                                         Content="github.com/fotlim/clashproxy" FontSize="13"
                                         Padding="0" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="版本" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VersionText" FontSize="13" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="协议" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License" FontSize="13" />
                    </Grid>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="这是一个学习项目">
                        <InfoBar.Content>
                            <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="ClashProxy 是个人练习作品，用来学习 WinUI 3 界面开发、.NET 8 进程与网络编程、mihomo 内核的配置合成与本地分流。它不含、也不提供任何订阅链接或节点，需要你自己准备 Clash 订阅。仅供学习交流使用，请遵守当地法律法规以及你所用订阅服务的条款；因使用产生的任何后果由使用者自行承担。" />
                        </InfoBar.Content>
                    </InfoBar>

                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="内核使用 MetaCubeX/mihomo（GPL-3.0），本程序本身以 MIT 协议开源。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
