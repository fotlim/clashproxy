<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashProxy.Views.SubscriptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,18,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="订阅与节点" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="粘贴你自己的 Clash 订阅链接，ClashProxy 会下载并解析其中的节点。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
        </StackPanel>

        <!-- 订阅输入 -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="订阅链接" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Grid.Column="0" PlaceholderText="https://example.com/api/v1/client/subscribe?token=..."
                             TextChanged="UrlBox_TextChanged" />
                    <Button x:Name="FetchBtn" Grid.Column="1" Content="下载并解析"
                            Style="{StaticResource AccentButtonStyle}" Click="FetchBtn_Click" />
                    <Button x:Name="ApplyBtn" Grid.Column="2" Content="应用到内核" Click="ApplyBtn_Click" />
                </Grid>
                <TextBlock x:Name="SubStatus" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="尚未导入订阅。" />
            </StackPanel>
        </Border>

        <!-- 节点列表 -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="4,12,4,4">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,0,16,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="节点" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button x:Name="TestAllBtn" Grid.Column="1" Content="全部测速" Click="TestAllBtn_Click" />
                    <Button x:Name="UseNodeBtn" Grid.Column="2" Content="使用选中节点"
                            Style="{StaticResource AccentButtonStyle}" Click="UseNodeBtn_Click" />
                </Grid>

                <ListView x:Name="NodeList" Grid.Row="1" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="NodeList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NodeItem" xmlns:local="using:ClashProxy">
                            <Grid ColumnSpacing="12" Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Latency}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
